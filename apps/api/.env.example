# Database (Local PostgreSQL on Docker Desktop)
DATABASE_URL="postgresql://sweety:sweety@localhost:5432/sweety?schema=public"

# Cache & Background Jobs (Local Redis on Docker Desktop)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Cookie
COOKIE_NAME="sweety_token"
COOKIE_MAX_AGE="604800000"
