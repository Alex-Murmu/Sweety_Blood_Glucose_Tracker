// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Slot {
  MORNING
  AFTER_BREAKFAST
  AFTER_LUNCH
  AFTER_DINNER
}

enum Role {
  PATIENT
  DOCTOR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  readings  Reading[]
  assignedPatients DoctorPatient[] @relation("DoctorAssignments") // patients assigned to this doctor
  assignedDoctors DoctorPatient[] @relation("PatientAssignments") // doctors assigned to this patient
  createdAt   DateTime @default(now())
}

model DoctorPatient {
  id        String   @id @default(cuid())
  doctor    User     @relation("DoctorAssignments", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId  String
  patient   User     @relation("PatientAssignments", fields: [patientId], references: [id], onDelete: Cascade)
  patientId String
  assignedAt DateTime @default(now())

  @@unique([doctorId, patientId])
}

model Reading {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime
  slot      Slot
  value     Int      @db.Integer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, slot])
  @@index([userId, date])
}
